"""Webカメラで車に貼ったArUcoマーカーを認識し、位置と向きを表示する

マーカーの上辺が車の前を向くように貼る。
終了は q キー。
"""
import math
import cv2

CAMERA_INDEX = 0
CAR_ID = 10  # 車に貼るマーカーのID
DICT = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_4X4_50)

# OpenCVのバージョン差を吸収
if hasattr(cv2.aruco, "ArucoDetector"):                  # 4.7以降
    _detector = cv2.aruco.ArucoDetector(DICT, cv2.aruco.DetectorParameters())
    def detect_markers(gray):
        return _detector.detectMarkers(gray)
else:                                                    # 4.6以前（apt版など）
    _params = cv2.aruco.DetectorParameters_create()
    def detect_markers(gray):
        return cv2.aruco.detectMarkers(gray, DICT, parameters=_params)


def find_car(corners, ids):
    """車の中心座標(px)と向き(度)を返す。見つからなければ None

    向きは画面の右を0度、反時計回りを正(上が90度)とする。
    """
    if ids is None:
        return None
    for c, i in zip(corners, ids.flatten()):
        if i != CAR_ID:
            continue
        pts = c[0]                      # 左上, 右上, 右下, 左下 の順
        center = pts.mean(axis=0)
        front = (pts[0] + pts[1]) / 2   # 上辺の中点 = 車の前
        back = (pts[2] + pts[3]) / 2
        # 画像のYは下向きなので符号を反転
        angle = math.degrees(math.atan2(-(front[1] - back[1]), front[0] - back[0]))
        return center, front, angle
    return None


def main():
    cap = cv2.VideoCapture(CAMERA_INDEX)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)

    while True:
        ok, frame = cap.read()
        if not ok:
            print("カメラから映像を取得できません")
            break

        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        corners, ids, _ = detect_markers(gray)

        if ids is not None:
            cv2.aruco.drawDetectedMarkers(frame, corners, ids)

        car = find_car(corners, ids)
        if car:
            center, front, angle = car
            cx, cy = int(center[0]), int(center[1])
            # 中心と前方向の矢印を描画
            cv2.circle(frame, (cx, cy), 5, (0, 255, 0), -1)
            cv2.arrowedLine(frame, (cx, cy), (int(front[0]), int(front[1])),
                            (0, 255, 0), 3, tipLength=0.4)
            text = f"CAR x={cx} y={cy} angle={angle:.0f}deg"
            cv2.putText(frame, text, (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
            print(text)
        else:
            cv2.putText(frame, "CAR not found", (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)

        cv2.imshow("car", frame)
        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()